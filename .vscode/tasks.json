{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "byebye: dry run",
      "type": "shell",
      "command": "./byebye --dry-run",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "byebye: help",
      "type": "shell",
      "command": "./byebye --help"
    },
    {
      "label": "byebye: bad flag (error test)",
      "type": "shell",
      "command": "./byebye --nonsense; echo \"exit code: $?\""
    }
  ]
}
